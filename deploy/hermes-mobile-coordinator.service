[Unit]
Description=Hermes Mobile bounded GitHub coordinator
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/hermes-mobile-git
ExecStart=/usr/bin/python3 %h/projects/hermes-mobile-git/scripts/cloud_coordinator.py --once --apply --state %S/hermes-mobile-coordinator/state.json
Environment=GH_PROMPT_DISABLED=1
UMask=0077
StateDirectory=hermes-mobile-coordinator
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/projects/hermes-mobile-git
ReadWritePaths=%S/hermes-mobile-coordinator
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
TimeoutStartSec=5min
